# Generated by install.ps1 — edit the template, not the generated file.
{
	# our own GlobalSign certificate is used, Caddy must not request certificates by itself
	auto_https disable_certs
	admin off
}

__DOMAIN__ {
	tls "__ROOT__/certs/fullchain.pem" "__ROOT__/certs/privkey.pem"
	encode zstd gzip
	header -Server
	reverse_proxy 127.0.0.1:__PORT__
	log {
		output file "__ROOT__/data/logs/caddy-access.log" {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

www.__DOMAIN__ {
	tls "__ROOT__/certs/fullchain.pem" "__ROOT__/certs/privkey.pem"
	redir https://__DOMAIN__{uri} permanent
}
