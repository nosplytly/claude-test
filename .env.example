# ===================== SupplierHub =====================
# prod on the server, dev locally
ENV=prod
BASE_URL=https://sh-control-universe.com
HOST=127.0.0.1
PORT=8000

# ---- Database ----
# PostgreSQL. install.ps1 installs it on the server, creates the database and writes these two lines itself
# (moving the data over from SQLite if there is any). Empty DATABASE_URL = a SQLite file in data\ (local runs, tests).
DATABASE_URL=
# folder with pg_dump / pg_restore, for the daily backups
PG_BIN=

# ---- Nervixy (Steam top-ups) ----
NERVIXY_API_KEY=
# Nervixy panel -> Settings -> Webhooks: URL https://sh-control-universe.com/api/webhooks/nervixy , paste whsec_... here
NERVIXY_WEBHOOK_SECRET=
# true = fake supplier for local testing (no real API calls)
NERVIXY_MOCK=false
# used only if api_me doesn't return the discount
NERVIXY_DISCOUNT_FALLBACK=4.5
# admin alert when supplier balance drops below (USD)
NERVIXY_LOW_BALANCE_USD=50

# ---- Pricing ----
# % discount for customers off the Steam nominal
CLIENT_DISCOUNT=3.75
# % extra for BTC/ETH/LTC/TON/TRX/SOL (conversion + volatility); USDT has none
VOLATILE_MARKUP=0.5
# minimum order in USD, same for every currency (never below nervixy's own 15 RUB)
MIN_ORDER_USD=0.2
MAX_ORDER_RUB=30000
INVOICE_TTL_MIN=30
MAX_ACTIVE_ORDERS=3
# balance top-ups (USD)
MIN_DEPOSIT_USD=0.2
MAX_DEPOSIT_USD=10000

# ---- Telegram ----
# token from @BotFather
BOT_TOKEN=
# your Telegram numeric id(s), comma separated (get it from @userinfobot)
ADMIN_TG_IDS=
# link shown as "Поддержка" (e.g. https://t.me/your_support)
SUPPORT_URL=

# ---- Built-in fail2ban (bans IPs that scan for holes, guess API keys, forge webhooks, hammer limits) ----
F2B_ENABLED=true
# points within the window that get an IP banned (scanner hit = 5, wrong API key = 2, 429 = 1)
F2B_MAX_POINTS=10
F2B_WINDOW_MIN=10
# first ban in minutes; a repeat within a week lasts 24x longer (max 7 days)
F2B_BAN_MIN=60
# your own IPs/subnets, comma separated: never banned by the site nor by the RDP guard (install.ps1 adds the IP
# you are connected from over RDP)
F2B_WHITELIST=

# ---- Receiving wallets: PUBLIC addresses only. Empty = that coin/network is hidden. ----
WALLET_USDT_TRC20=
WALLET_USDT_TON=
WALLET_USDT_BEP20=
WALLET_USDT_SOL=
WALLET_USDT_ERC20=
WALLET_BTC=
WALLET_ETH=
WALLET_TON=
WALLET_LTC=
WALLET_TRX=
WALLET_SOL=

# ---- Blockchain API keys: free, but needed for real traffic (tools\preflight.py checks they work) ----
# https://www.trongrid.io -> sign up -> API keys (without it TronGrid throttles hard: TRON payments arrive late)
TRONGRID_API_KEY=
# @tonapibot in Telegram -> toncenter key (without it: 1 request per second)
TONCENTER_API_KEY=
# https://tonconsole.com -> TonAPI key: the second check of TON payments (without it: ~1 request per second)
TONAPI_KEY=
# public RPCs are used by default; a paid/own node is better under load
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# SOL_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Second opinion on every payment (another provider than the ones above confirms it before crediting) ----
CROSSCHECK_ENABLED=true
# defaults: TRON publicnode, ETH drpc/1rpc, BSC bnbchain/1rpc, BTC blockstream/mempool, LTC blockbook/blockcypher,
# TON tonapi, SOL publicnode — override only if one of them goes away:
# TRON_CHECK_URL=https://tron-rpc.publicnode.com
# ETH_CHECK_URLS=https://eth.drpc.org,https://1rpc.io/eth
# BSC_CHECK_URLS=https://bsc-dataseed.bnbchain.org,https://1rpc.io/bnb
# SOL_CHECK_URL=https://solana-rpc.publicnode.com
# BTC_CHECK_URLS=https://blockstream.info/api,https://mempool.space/api
# LTC_CHECK_URLS=https://litecoinblockexplorer.net/api/v2,https://api.blockcypher.com/v1/ltc/main